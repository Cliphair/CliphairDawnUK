{{ 'section-image-reveal-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign total_images = section.blocks.size

  assign today_ts = 'now' | date: '%Y-%m-%d' | append: ' 00:00' | date: '%s' | times: 1
  assign final_date_string = section.settings.final_year | append: '-' | append: section.settings.final_month | append: '-' | append: section.settings.final_day | append: ' 00:00'
  assign final_date_ts = final_date_string | date: '%s' | times: 1
  assign days_remaining = final_date_ts | minus: today_ts | divided_by: 86400

  assign revealed_count = total_images | minus: days_remaining | plus: 1
  if revealed_count < 0
    assign revealed_count = 0
  endif
  if revealed_count > total_images
    assign revealed_count = total_images
  endif
-%}

{%- if total_images > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      <ul
        class="image-reveal-grid grid grid--2-col-tablet-down grid--4-col-desktop"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_revealed = false
            if forloop.index <= revealed_count
              assign is_revealed = true
            endif
          -%}
          <li
            class="image-reveal-grid__item grid__item{% unless is_revealed %} image-reveal-grid__item--blurred{% endunless %}"
            {{ block.shopify_attributes }}
          >
            <div class="image-reveal-grid__media media media--square">
              {%- if block.settings.image != blank -%}
                {{-
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '165, 330, 535, 750, 1000',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    alt: block.settings.image.alt
                  | escape
                -}}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-reveal-grid.name",
  "tag": "section",
  "class": "section section-image-reveal-grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.image-reveal-grid.settings.header__final_date.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.image-reveal-grid.settings.paragraph__final_date.content"
    },
    {
      "type": "number",
      "id": "final_year",
      "label": "t:sections.image-reveal-grid.settings.number_final_year.label",
      "default": 2027
    },
    {
      "type": "select",
      "id": "final_month",
      "label": "t:sections.image-reveal-grid.settings.select_final_month.label",
      "options": [
        { "value": "1", "label": "January" },
        { "value": "2", "label": "February" },
        { "value": "3", "label": "March" },
        { "value": "4", "label": "April" },
        { "value": "5", "label": "May" },
        { "value": "6", "label": "June" },
        { "value": "7", "label": "July" },
        { "value": "8", "label": "August" },
        { "value": "9", "label": "September" },
        { "value": "10", "label": "October" },
        { "value": "11", "label": "November" },
        { "value": "12", "label": "December" }
      ],
      "default": "12"
    },
    {
      "type": "range",
      "id": "final_day",
      "label": "t:sections.image-reveal-grid.settings.range_final_day.label",
      "min": 1,
      "max": 31,
      "step": 1,
      "default": 25
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.image-reveal-grid.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-reveal-grid.blocks.image.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-reveal-grid.presets.name",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
