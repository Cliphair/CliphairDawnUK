{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-hero-slideshow.css' | asset_url | stylesheet_tag }}

{%- assign animate = false -%}
{%- if settings.animations_reveal_on_scroll and section.settings.above_the_fold == false -%}
  {%- assign animate = true -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Slider-{{ section.id }} {
    --banner-ratio-mobile: {{ section.settings.ratio_w_mobile }} / {{ section.settings.ratio_h_mobile }};
    --banner-ratio-desktop: {{ section.settings.ratio_w_desktop }} / {{ section.settings.ratio_h_desktop }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <slideshow-component
    class="hero-slideshow slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %} {% if section.settings.trackable_name != blank %}trackable-section{% endif %}"
    role="region"
    aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
    aria-label="{{ section.settings.accessibility_info | escape }}"
    {% if section.settings.trackable_name != blank %}
      id="{{ section.settings.trackable_name | handleize }}"
      data-section-name="{{ section.settings.trackable_name | handleize }}"
      data-section-instance="{{ section.id }}"
    {% else %}
      id="{{ section.id }}"
    {% endif %}
  >
    {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
      <div class="slideshow__controls slideshow__controls--top slider-buttons no-js-hidden{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
        <button
          type="button"
          class="slider-button slider-button--prev visually-hidden"
          name="previous"
          aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>
        <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
          {%- if section.settings.slider_visual == 'counter' -%}
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          {%- else -%}
            <div class="slideshow__control-wrapper">
              {%- for block in section.blocks -%}
                <button
                  class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                  aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  {%- if section.settings.slider_visual == 'numbers' -%}
                    {{ forloop.index -}}
                  {%- else -%}
                    <span class="dot"></span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <button
          type="button"
          class="slider-button slider-button--next visually-hidden"
          name="next"
          aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>

        {%- if section.settings.auto_rotate -%}
          <button
            type="button"
            class="slideshow__autoplay slider-button no-js-hidden{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
            aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
          >
            {%- render 'icon-pause' -%}
            {%- render 'icon-play' -%}
          </button>
        {%- endif -%}
      </div>
      <noscript>
        <div class="slider-buttons">
          <div class="slider-counter">
            {%- for block in section.blocks -%}
              <a
                href="#Slide-{{ section.id }}-{{ forloop.index }}"
                class="slider-counter__link link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              >
                {{ forloop.index }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      </noscript>
    {%- endif -%}

    <div
      class="hero-slideshow slideshow banner grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      id="Slider-{{ section.id }}"
      aria-live="polite"
      aria-atomic="true"
      data-autoplay="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed }}"
      {% if section.settings.trackable_name != blank %}
        data-horizontal-scroll
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_eager = false
          if section.settings.above_the_fold and forloop.first
            assign is_eager = true
          endif
        -%}

        {%- if block.type == 'slide' -%}
          <style>
            #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
              opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
            }
          </style>
          {% if block.settings.image_url %}
            <a
              href="{{ block.settings.image_url }}"
              class="slideshow__slide grid__item grid--1-col slider__slide"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
              role="group"
              aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
              aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              tabindex="-1"
              {% if section.settings.trackable_name != blank %}
                data-event-type="section_click"
                data-cta-label="click_banner_{{ block.settings.banner_id | handleize | replace: "-", "_" }}"
              {% endif %}
            >
          {% else %}
            <div
              class="slideshow__slide grid__item grid--1-col slider__slide"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
              role="group"
              aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
              aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              tabindex="-1"
              {% if section.settings.trackable_name != blank %}
                data-event-type="section_click"
                data-cta-label="click_banner_{{ block.settings.banner_id | handleize | replace: "-", "_" }}"
              {% endif %}
            >
          {% endif %}
          <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {%- if block.settings.image -%}
              {%- liquid
                assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                if section.settings.image_behavior == 'ambient'
                  assign sizes = '120vw'
                  assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
                else
                  assign sizes = '100vw'
                  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                endif

                assign img_loading = 'lazy'
                assign img_fetchpriority = 'auto'
                if is_eager
                  assign img_loading = 'eager'
                  assign img_fetchpriority = 'high'
                endif
              -%}
              <picture>
                <source media="(max-width:768px)" srcset="{{ block.settings.image | image_url: width: 768 }}">
                {% if block.settings.image_desktop %}
                  <source
                    media="(min-width:769px)"
                    srcset="{{ block.settings.image_desktop | image_url: width: 3840 }}"
                  >
                {% endif %}
                <img
                  src="{{ block.settings.image | image_url: width: 768 }}"
                  loading="{{ img_loading }}"
                  fetchpriority="{{ img_fetchpriority }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ widths }}"
                  height="{{ height }}"
                  sizes="{{ sizes }}"
                >
              </picture>
            {%- else -%}
              {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
              {%- if placeholder_slide == 1 -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}
          </div>
          <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
            <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div class="banner__text rte" {{ block.shopify_attributes }}>
                  <p>{{ block.settings.subheading }}</p>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="banner__buttons">
                  <a
                    {% if block.settings.link %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
          {% if block.settings.image_url %}
            </a>
          {% else %}
            </div>
          {% endif %}

        {%- elsif block.type == 'hero' -%}
          {%- liquid
            assign primary_loading = 'lazy'
            assign primary_fetchpriority = 'auto'
            assign primary_preload = false
            if is_eager
              assign primary_loading = 'eager'
              assign primary_preload = true
              unless block.settings.decorative
                assign primary_fetchpriority = 'high'
              endunless
            endif

            assign secondary_loading = 'lazy'
            assign secondary_fetchpriority = 'auto'
            if is_eager
              assign secondary_loading = 'eager'
            endif
          -%}
          <div
            class="slideshow__slide grid__item grid--1-col slider__slide"
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            tabindex="-1"
            {% if section.settings.trackable_name != blank %}
              data-event-type="section_click"
              data-cta-label="click_banner_{{ block.settings.banner_id | handleize | replace: "-", "_" }}"
            {% endif %}
          >
            {%- if block.settings.show_primary_image -%}
              {%- render 'hero-banner-layer',
                layer_type: 'image',
                animate: animate,
                pos_x_desktop: block.settings.position_x_desktop,
                pos_y_desktop: block.settings.position_y_desktop,
                anchor_desktop: block.settings.anchor_point_desktop,
                width_desktop: block.settings.width_desktop,
                size_multiplier_desktop: block.settings.size_multiplier_desktop,
                pos_x_mobile: block.settings.position_x_mobile,
                pos_y_mobile: block.settings.position_y_mobile,
                anchor_mobile: block.settings.anchor_point_mobile,
                width_mobile: block.settings.width_mobile,
                size_multiplier_mobile: block.settings.size_multiplier,
                z_index: block.settings.z_index,
                image: block.settings.image,
                alt_text: block.settings.alt_text,
                decorative: block.settings.decorative,
                object_position_x: block.settings.object_position_x,
                object_position_y: block.settings.object_position_y,
                img_loading: primary_loading,
                img_fetchpriority: primary_fetchpriority,
                img_preload: primary_preload
              -%}
            {%- endif -%}

            {%- if block.settings.show_secondary_image -%}
              {%- render 'hero-banner-layer',
                layer_type: 'image',
                animate: animate,
                pos_x_desktop: block.settings.position_x_desktop_2,
                pos_y_desktop: block.settings.position_y_desktop_2,
                anchor_desktop: block.settings.anchor_point_desktop_2,
                width_desktop: block.settings.width_desktop_2,
                size_multiplier_desktop: block.settings.size_multiplier_desktop_2,
                pos_x_mobile: block.settings.position_x_mobile_2,
                pos_y_mobile: block.settings.position_y_mobile_2,
                anchor_mobile: block.settings.anchor_point_mobile_2,
                width_mobile: block.settings.width_mobile_2,
                size_multiplier_mobile: block.settings.size_multiplier_2,
                z_index: block.settings.z_index_2,
                image: block.settings.image_2,
                alt_text: block.settings.alt_text_2,
                decorative: block.settings.decorative_2,
                object_position_x: block.settings.object_position_x_2,
                object_position_y: block.settings.object_position_y_2,
                img_loading: secondary_loading,
                img_fetchpriority: secondary_fetchpriority,
                img_preload: false
              -%}
            {%- endif -%}

            {%- if block.settings.show_text -%}
              {%- render 'hero-banner-layer',
                layer_type: 'text',
                animate: animate,
                pos_x_desktop: block.settings.text_position_x_desktop,
                pos_y_desktop: block.settings.text_position_y_desktop,
                anchor_desktop: block.settings.text_anchor_point_desktop,
                width_desktop: block.settings.text_width_desktop,
                pos_x_mobile: block.settings.text_position_x_mobile,
                pos_y_mobile: block.settings.text_position_y_mobile,
                anchor_mobile: block.settings.text_anchor_point_mobile,
                width_mobile: block.settings.text_width_mobile,
                z_index: block.settings.text_z_index,
                heading: block.settings.heading,
                subheading: block.settings.subheading,
                button_label: block.settings.button_label,
                button_url: block.settings.button_url,
                show_container: block.settings.show_container,
                color_scheme: block.settings.color_scheme,
                show_flower_mask: block.settings.show_flower_mask,
                padding: block.settings.padding,
                heading_level: section.settings.heading_level
              -%}
            {%- endif -%}
          </div>

        {%- elsif block.type == 'countdown' -%}
          {%- liquid
            assign end_hour_value = 23
            assign end_minute_value = 59
            if block.settings.custom_end_time
              assign end_hour_value = block.settings.end_hour
              assign end_minute_value = block.settings.end_minute
            endif

            assign end_date_string = block.settings.end_year | append: '-' | append: block.settings.end_month | append: '-' | append: block.settings.end_day | append: ' ' | append: end_hour_value | append: ':' | append: end_minute_value
            assign end_date_ts = end_date_string | date: '%s' | times: 1

            assign end_date_year = end_date_ts | date: '%Y'
            assign end_date_month = end_date_ts | date: '%m'
            assign end_date_day = end_date_ts | date: '%d'
            assign end_date_hour = end_date_ts | date: '%H'
            assign end_date_minute = end_date_ts | date: '%M'
            assign end_date_label = end_date_ts | date: '%B %e, %Y, %H:%M'
          -%}
          <div
            class="slideshow__slide grid__item grid--1-col slider__slide hero-slideshow__countdown-slide color-{{ block.settings.color_scheme }} gradient"
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            tabindex="-1"
            {% if section.settings.trackable_name != blank %}
              data-event-type="section_click"
              data-cta-label="click_banner_{{ block.settings.banner_id | handleize | replace: "-", "_" }}"
            {% endif %}
          >
            <div class="hero-slideshow__countdown-content">
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-slideshow__countdown-heading inline-richtext h1">
                  {% comment %} {{ block.settings.heading }} {% endcomment %}
                  <span class="medium-hide large-up-hide"
                    >Something <br>
                    Is About To <br>
                    Bloom...</span
                  >
                  <span class="small-hide">Something's About to Bloom...</span>
                </h2>
              {%- endif -%}

              <custom-countdown
                class="countdown hero-slideshow__countdown"
                data-end-day="{{ end_date_day }}"
                data-end-month="{{ end_date_month }}"
                data-end-year="{{ end_date_year }}"
                data-end-hour="{{ end_date_hour }}"
                data-end-minute="{{ end_date_minute }}"
                data-show-digits="true"
                role="timer"
                aria-label="{{ "Countdown ends " | append: end_date_label }}"
              >
                <div class="hero-slideshow__countdown-container" aria-hidden="true">
                  <div class="hero-slideshow__countdown-digit">
                    <span class="countdown__days">00</span>
                  </div>
                  <span class="hero-slideshow__countdown-label">Days</span>
                </div>
                <div class="hero-slideshow__countdown-container" aria-hidden="true">
                  <div class="hero-slideshow__countdown-digit">
                    <span class="countdown__hours">00</span>
                  </div>
                  <span class="hero-slideshow__countdown-label">Hours</span>
                </div>
                <div class="hero-slideshow__countdown-container" aria-hidden="true">
                  <div class="hero-slideshow__countdown-digit">
                    <span class="countdown__minutes">00</span>
                  </div>
                  <span class="hero-slideshow__countdown-label">Mins</span>
                </div>
                <div class="hero-slideshow__countdown-container" aria-hidden="true">
                  <div class="hero-slideshow__countdown-digit">
                    <span class="countdown__seconds">00</span>
                  </div>
                  <span class="hero-slideshow__countdown-label">Secs</span>
                </div>
              </custom-countdown>

              {%- if block.settings.button_label != blank -%}
                <div class="hero-slideshow__countdown-cta">
                  <a
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="{% if block.settings.button_style == 'button' %}button{% else %}link underlined-link caption-with-letter-spacing{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
      <div class="slideshow__controls slider-buttons no-js-hidden{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>
        <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
          {%- if section.settings.slider_visual == 'counter' -%}
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          {%- else -%}
            <div class="slideshow__control-wrapper">
              {%- for block in section.blocks -%}
                <button
                  class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                  aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  {%- if section.settings.slider_visual == 'numbers' -%}
                    {{ forloop.index -}}
                  {%- else -%}
                    <span class="dot"></span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>

        {%- if section.settings.auto_rotate -%}
          <button
            type="button"
            class="slideshow__autoplay slider-button no-js-hidden{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
            aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
          >
            {%- render 'icon-pause' -%}
            {%- render 'icon-play' -%}
          </button>
        {%- endif -%}
      </div>
      <noscript>
        <div class="slider-buttons">
          <div class="slider-counter">
            {%- for block in section.blocks -%}
              <a
                href="#Slide-{{ section.id }}-{{ forloop.index }}"
                class="slider-counter__link link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              >
                {{ forloop.index }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      </noscript>
    {%- endif -%}
  </slideshow-component>
</div>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "section section-hero-slideshow",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Desktop aspect ratio"
    },
    {
      "type": "range",
      "id": "ratio_w_desktop",
      "min": 1,
      "max": 21,
      "step": 1,
      "label": "Width",
      "default": 16
    },
    {
      "type": "range",
      "id": "ratio_h_desktop",
      "min": 1,
      "max": 21,
      "step": 1,
      "label": "Height",
      "default": 9
    },
    {
      "type": "header",
      "content": "Mobile aspect ratio"
    },
    {
      "type": "range",
      "id": "ratio_w_mobile",
      "min": 1,
      "max": 21,
      "step": 1,
      "label": "Width",
      "default": 4
    },
    {
      "type": "range",
      "id": "ratio_h_mobile",
      "min": 1,
      "max": 21,
      "step": 1,
      "label": "Height",
      "default": 3
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.all.heading_size.label",
      "info": "Applies to the heading on Hero blocks.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
