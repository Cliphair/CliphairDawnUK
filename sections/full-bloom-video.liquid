{{ 'component-full-bloom.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'section-full-bloom-video.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="full-bloom-shell full-bloom-video page-width">
    <div class="full-bloom-video__heading">
      <h2 class="full-bloom-video__title chocolatier">{{ section.settings.heading }}</h2>
      {%- if section.settings.eyebrow != blank -%}
        <p class="full-bloom-eyebrow full-bloom-video__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.video != blank -%}
      <deferred-media class="full-bloom-video__player deferred-media" data-media-id="{{ section.id }}">
        <button
          id="Deferred-Poster-{{ section.id }}"
          class="full-bloom-video__poster deferred-media__poster"
          type="button"
          aria-label="{{ 'sections.video.load_video' | t: description: section.settings.heading | escape }}"
        >
          {%- if section.settings.poster_image != blank -%}
            {{
              section.settings.poster_image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1500',
                sizes: '(min-width: 990px) 68rem, 90vw',
                class: 'full-bloom-video__poster-img',
                alt: '',
                width: section.settings.poster_image.width,
                height: section.settings.poster_image.height
            }}
          {%- else -%}
            <img
              src="{{ 'full-bloom-glass-marque-texture.png' | asset_url }}"
              loading="lazy"
              alt=""
              class="full-bloom-video__texture"
              width="500"
              height="510"
            >
          {%- endif -%}
          <span class="full-bloom-video__play" aria-hidden="true">
            <img src="{{ 'full-bloom-play-icon.svg' | asset_url }}" loading="lazy" alt="" width="146" height="146">
          </span>
        </button>
        <template>
          {{
            section.settings.video
            | video_tag:
              image_size: '1500x',
              autoplay: true,
              controls: true,
              muted: false,
              loop: false,
              class: 'full-bloom-video__video',
              playsinline: true
          }}
        </template>
      </deferred-media>
    {%- else -%}
      <div class="full-bloom-video__player full-bloom-video__player--empty">
        <img
          src="{{ 'full-bloom-glass-marque-texture.png' | asset_url }}"
          loading="lazy"
          alt=""
          class="full-bloom-video__texture"
          width="500"
          height="510"
        >
        <span class="full-bloom-video__play" aria-hidden="true">
          <img src="{{ 'full-bloom-play-icon.svg' | asset_url }}" loading="lazy" alt="" width="146" height="146">
        </span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.full-bloom-video.name",
  "tag": "section",
  "class": "section section-full-bloom-video",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "pink-main"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.full-bloom-video.settings.heading.label",
      "default": "Meet the new us."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.full-bloom-video.settings.eyebrow.label",
      "default": "Nineteen years in the making"
    },
    {
      "type": "header",
      "content": "t:sections.full-bloom-video.settings.header__video.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.full-bloom-video.settings.video.label"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "t:sections.full-bloom-video.settings.poster_image.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.full-bloom-video.presets.name"
    }
  ]
}
{% endschema %}
