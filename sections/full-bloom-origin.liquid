{{ 'component-full-bloom.css' | asset_url | stylesheet_tag }}
{{ 'section-full-bloom-origin.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #FullBloomOrigin-{{ section.id }} .full-bloom-origin__photo {
    mask-image: url({{ 'full-bloom-yellow-mask.svg' | asset_url }});
    -webkit-mask-image: url({{ 'full-bloom-yellow-mask.svg' | asset_url }});
  }
{%- endstyle -%}

<div
  id="FullBloomOrigin-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="full-bloom-shell full-bloom-origin page-width">
    <div class="full-bloom-origin__text">
      <h2 class="full-bloom-origin__heading chocolatier">{{ section.settings.heading }}</h2>
      {%- if section.settings.eyebrow != blank -%}
        <p class="full-bloom-eyebrow full-bloom-origin__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="full-bloom-origin__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="full-bloom-origin__media">
      <div class="full-bloom-origin__photo">
        {%- if section.settings.image != blank -%}
          {%- assign image_alt = section.settings.image.alt | escape -%}
          <picture>
            {%- if section.settings.image_desktop != blank -%}
              <source media="(min-width: 990px)" srcset="{{ section.settings.image_desktop | image_url: width: 1200 }}">
            {%- endif -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 900, 1200',
                sizes: '(min-width: 990px) 58rem, 90vw',
                alt: image_alt,
                width: section.settings.image.width,
                height: section.settings.image.height
            }}
          </picture>
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.full-bloom-origin.name",
  "tag": "section",
  "class": "section section-full-bloom-origin",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.full-bloom-origin.settings.eyebrow.label",
      "default": "Where this all came from"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.full-bloom-origin.settings.heading.label",
      "default": "You built this, really."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.full-bloom-origin.settings.text.label",
      "default": "<p>Over the past year we asked you properly. Thousands of you, in your reviews and your messages, you told us what actually matters: fuller hair, the length you really want, feeling like yourself and walking into the room differently. The new look is a reflection of you, in your full bloom era.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.full-bloom-origin.settings.header__image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.full-bloom-origin.settings.image.label",
      "info": "t:sections.full-bloom-origin.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:sections.full-bloom-origin.settings.image_desktop.label",
      "info": "t:sections.full-bloom-origin.settings.image_desktop.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.full-bloom-origin.presets.name"
    }
  ]
}
{% endschema %}
