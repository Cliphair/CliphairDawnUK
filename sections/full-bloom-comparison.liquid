{{ 'component-full-bloom.css' | asset_url | stylesheet_tag }}
{{ 'section-full-bloom-comparison.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="full-bloom-shell full-bloom-comparison page-width">
    <h2 class="full-bloom-comparison__heading chocolatier">{{ section.settings.heading }}</h2>

    <div class="full-bloom-comparison__cards">
      <div class="full-bloom-comparison__card color-green-main">
        <h3 class="full-bloom-comparison__card-heading chocolatier">{{ section.settings.new_heading }}</h3>
        <ul class="full-bloom-comparison__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'new_point' -%}
              <li class="full-bloom-comparison__item" {{ block.shopify_attributes }}>
                <img
                  src="{{ 'full-bloom-icon-mark-charcoal.svg' | asset_url }}"
                  loading="lazy"
                  alt=""
                  class="full-bloom-comparison__icon"
                  width="15"
                  height="16"
                >
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="full-bloom-comparison__card color-purple-main">
        <h3 class="full-bloom-comparison__card-heading chocolatier">{{ section.settings.moved_heading }}</h3>
        <ul class="full-bloom-comparison__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'not_moved_point' -%}
              <li class="full-bloom-comparison__item" {{ block.shopify_attributes }}>
                <img
                  src="{{ 'full-bloom-icon-mark-offwhite.svg' | asset_url }}"
                  loading="lazy"
                  alt=""
                  class="full-bloom-comparison__icon"
                  width="15"
                  height="16"
                >
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.full-bloom-comparison.name",
  "tag": "section",
  "class": "section section-full-bloom-comparison",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "blue-main"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.full-bloom-comparison.settings.heading.label",
      "default": "New look. Same everything that counts."
    },
    {
      "type": "header",
      "content": "t:sections.full-bloom-comparison.settings.header__new.content"
    },
    {
      "type": "text",
      "id": "new_heading",
      "label": "t:sections.full-bloom-comparison.settings.new_heading.label",
      "default": "What is new"
    },
    {
      "type": "header",
      "content": "t:sections.full-bloom-comparison.settings.header__moved.content"
    },
    {
      "type": "text",
      "id": "moved_heading",
      "label": "t:sections.full-bloom-comparison.settings.moved_heading.label",
      "default": "What has not moved"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "new_point",
      "name": "t:sections.full-bloom-comparison.blocks.new_point.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.full-bloom-comparison.blocks.new_point.settings.text.label",
          "default": "A brighter, bolder look everywhere you see us."
        }
      ]
    },
    {
      "type": "not_moved_point",
      "name": "t:sections.full-bloom-comparison.blocks.not_moved_point.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.full-bloom-comparison.blocks.not_moved_point.settings.text.label",
          "default": "100% real human hair, like always, since 2007."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.full-bloom-comparison.presets.name",
      "blocks": [
        { "type": "new_point", "settings": { "text": "A brighter, bolder look everywhere you see us." } },
        { "type": "new_point", "settings": { "text": "New packaging, landing with your next order." } },
        { "type": "new_point", "settings": { "text": "A name and a mark that finally mean something." } },
        { "type": "not_moved_point", "settings": { "text": "100% real human hair, like always, since 2007." } },
        { "type": "not_moved_point", "settings": { "text": "The same team, and the same people answering." } },
        { "type": "not_moved_point", "settings": { "text": "Free UK returns and the same fuss over your order." } }
      ]
    }
  ]
}
{% endschema %}
