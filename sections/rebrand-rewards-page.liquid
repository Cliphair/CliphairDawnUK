{% liquid 
    assign customer_eligible = false

    if customer
        if customer.tags contains 'yotpo-tiers-icon' or customer.tags contains 'yotpo-tiers-inner-circle' or customer.tags contains 'yotpo-tiers-insider' or customer.tags contains 'yotpo-tiers-member'
            assign customer_eligible = true
        endif    
    endif
%}


<style>
  @font-face {
    font-family: 'Chocolatier';
    src: url('{{ "Chocolatier.woff2" | asset_url }}') format('woff2'),
        url('{{ "Chocolatier.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    }

    @font-face {
      font-family: "Plus Jakarta Sans";
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      src: url("//www.cliphair.co.uk/cdn/fonts/plus_jakarta_sans/plusjakartasans_n4.d80b0f185669787ac4b44bf52c1a511eaaf37245.woff2") format("woff2"),
          url("//www.cliphair.co.uk/cdn/fonts/plus_jakarta_sans/plusjakartasans_n4.4d079d103b5ee647346f5effc3692759629e07c9.woff") format("woff");
    }
</style>

<script>
  window.canSeeRewardsRebrand = {{ customer_eligible | default: false }};

  (function () {
    function insertRewardsBanner() {
      // ...same as before...
    }

    function init() {
      // ...same as before...
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
