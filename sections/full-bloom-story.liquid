{{ 'component-full-bloom.css' | asset_url | stylesheet_tag }}
{{ 'section-full-bloom-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="full-bloom-shell full-bloom-story page-width">
    <div class="full-bloom-story__media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_desktop != blank -%}
            <source media="(min-width: 990px)" srcset="{{ section.settings.image_desktop | image_url: width: 1940 }}">
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 1120
            | image_tag:
              loading: 'lazy',
              widths: '480, 700, 900, 1120',
              sizes: '(min-width: 990px) 96.6rem, 90vw',
              alt: '',
              width: section.settings.image.width,
              height: section.settings.image.height
          }}
        </picture>
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="full-bloom-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="full-bloom-eyebrow full-bloom-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="full-bloom-story__heading chocolatier">{{ section.settings.heading }}</h2>
    </div>

    {%- if section.settings.text != blank -%}
      <div class="full-bloom-story__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.tagline != blank -%}
      <p class="full-bloom-story__tagline chocolatier">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.full-bloom-story.name",
  "tag": "section",
  "class": "section section-full-bloom-story",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "purple-main"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.full-bloom-story.settings.eyebrow.label",
      "default": "FROM BUD TO BLOOM"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.full-bloom-story.settings.heading.label",
      "default": "We are not here to change you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.full-bloom-story.settings.text.label",
      "default": "<p>Extensions do not turn you into someone new. They give you more of what is already yours. More length when the mood takes you. More volume when you want it. More of those glance-in-the-mirror moments where you think, there I am.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "tagline",
      "label": "t:sections.full-bloom-story.settings.tagline.label",
      "default": "Be the you you want to be."
    },
    {
      "type": "header",
      "content": "t:sections.full-bloom-story.settings.header__image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.full-bloom-story.settings.image.label",
      "info": "t:sections.full-bloom-story.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:sections.full-bloom-story.settings.image_desktop.label",
      "info": "t:sections.full-bloom-story.settings.image_desktop.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.full-bloom-story.presets.name"
    }
  ]
}
{% endschema %}
